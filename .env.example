# ===== LLM =====
LLM_PROVIDER=openai
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini
# ===== AWS (trabajo, opcional) =====
# LLM_PROVIDER=bedrock
# AWS_REGION=us-east-1
# BEDROCK_MODEL_ID=anthropic.claude-3-5-sonnet-20240620-v1:0
# ===== RAG (Elasticsearch / OpenSearch) =====
ELASTIC_URL=https://...
ELASTIC_API_KEY=...

# ===== MCP =====
# Servidor MCP propio (validairisk). En Cloud Run: URL del servicio + /mcp (sin barra final).
# En docker-compose se inyecta automáticamente (http://mcp-server:8080/mcp/).
VALIDAIRISK_MCP_URL=https://validairisk-mcp-XXXX.run.app/mcp
# MCP externo de busqueda web (Tavily) — free tier: https://tavily.com
TAVILY_API_KEY=tvly-...

# ===== Frontend =====
# URL del backend que consume el frontend (en compose: http://backend:8000)
BACKEND_URL=http://localhost:8000
# ===== Memoria (opcional) =====
# MEMORIA_DB=memoria_validairisk.db
