# LLM: openai (curso) o bedrock (trabajo AWS)
LLM_PROVIDER=openai
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini
# Si LLM_PROVIDER=bedrock:
# AWS_REGION=us-east-1
# BEDROCK_MODEL_ID=anthropic.claude-3-5-sonnet-20240620-v1:0
# RAG (Elasticsearch / OpenSearch compatible)
ELASTIC_URL=https://...
ELASTIC_API_KEY=...
